                  "soc2",
                  "CC8.1"
                ],
                "precision": "high",
                "security-severity": "8.0",
                "criterion": "CC8.1"
              }
            },
            {
              "id": "cc9.1/continuity-plan",
              "name": "ContinuityPlan",
              "shortDescription": {
                "text": "A business continuity and disaster recovery plan covers this system"
              },
              "fullDescription": {
                "text": "A BC/DR plan lists critical dependencies and their fallbacks, how the system is recovered, and what happens in a provider or regional outage."
              },
              "help": {
                "text": "Write a short continuity plan: critical dependencies, what degrades gracefully, recovery steps, and who decides.\n\nRisk: A provider outage or loss of a key component turns into an improvised, extended outage.",
                "markdown": "**CC9.1**: A BC/DR plan lists critical dependencies and their fallbacks, how the system is recovered, and what happens in a provider or regional outage.\n\n**Risk:** A provider outage or loss of a key component turns into an improvised, extended outage.\n\n**Fix:** Write a short continuity plan: critical dependencies, what degrades gracefully, recovery steps, and who decides.\n\nExample:\n\n```\n## Critical dependencies\n| Dependency | If unavailable |\n|---|---|\n| Auth provider | Existing sessions continue; new logins fail with a status banner |\n## Recovery\nRebuild from IaC in the secondary region; restore the latest snapshot.\n```"
              },
              "defaultConfiguration": {
